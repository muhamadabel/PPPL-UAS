# Salin file ini menjadi .env lalu sesuaikan jika perlu.
# Semua nilai punya default di config/TestConfig.java, jadi .env opsional.

# URL frontend Next.js yang sedang berjalan.
# Lokal (default): http://localhost:3001  (FE: npm run dev -- -p 3001)
BASE_URL=http://localhost:3001

# Akun dosen hasil seed BE
DOSEN_EMAIL=dosen@gmail.com
DOSEN_PASSWORD=dosen123

# true = browser tidak tampil (CI). false = tampil (default, enak untuk demo).
HEADLESS=false
